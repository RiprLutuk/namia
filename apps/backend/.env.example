PORT=3000
NODE_ENV=development

# PostgreSQL Database Connection URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/namia

# Internal Security & API Authentication
NAMIA_API_KEY=namia-secure-internal-api-key-2026

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173
