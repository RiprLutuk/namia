{
  "name": "financial-template-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter \"*\" --parallel dev",
    "dev:backend": "bun --filter backend dev",
    "dev:frontend": "bun --filter frontend dev",
    "build": "bun --filter \"*\" build",
    "test": "bun --filter \"*\" test",
    "check": "bun --filter \"*\" check",
    "db:migrate": "bun --filter backend db:migrate",
    "db:seed": "bun --filter backend db:seed",
    "admin:create": "bun --filter backend admin:create",
    "test:e2e": "bun run build && bun --filter frontend test:e2e"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "cookie": "1.1.1",
    "esbuild": "^0.28.0"
  }
}
